<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <include resource="org/springframework/boot/logging/logback/file-appender.xml"/>

    <!--
      平台自身日志 → Logstash（任务书 M4 第 1 项：Logstash 收到 aiops-platform 自身日志；
      v2 §8.5：TCP 5000 / json_lines / customFields.service 与 monitor_target.log_service_name 对应）。
      Drain 训练域白名单里包含 aiops-platform，本 appender 就是它的数据来源。
    -->
    <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>10.0.0.91:5000</destination>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"aiops-platform","env":"dev"}</customFields>
        </encoder>
        <!-- Logstash 不可达时不阻塞业务线程 -->
        <reconnectionDelay>30 second</reconnectionDelay>
        <writeTimeout>5 second</writeTimeout>
    </appender>

    <!-- M4 收尾（审查方要求）：平台自身日志默认 WARN，只 alert / incident / 调用链路留 INFO -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOGSTASH"/>
    </root>

    <logger name="com.aiops" level="WARN"/>
    <!-- 告警 + 事件 是平台业务主线，留 INFO 便于 M3/M4 演示 -->
    <logger name="com.aiops.module.alert" level="INFO"/>
    <logger name="com.aiops.module.incident" level="INFO"/>
    <!-- log 模块的 Job 结果、LLM 调用结果，留 INFO 便于 M4/M5 验收 -->
    <logger name="com.aiops.module.log.service" level="INFO"/>
    <logger name="com.aiops.schedule" level="INFO"/>
    <!-- Spring/Jackson/JDBC/MyBatis/MyBatis-SQL 全部 WARN。
         MyBatis 的 mapper 日志 logger 名是 <mapper-接口-FQN>.方法名，包树在 com.aiops.module.*，
         此处对 8 个 mapper 包显式 WARN 防止 SQL 噪声淹没平台业务日志。 -->
    <logger name="com.aiops.module.monitor.mapper" level="WARN" additivity="false"/>
    <logger name="com.aiops.module.alert.mapper" level="WARN" additivity="false"/>
    <logger name="com.aiops.module.log.mapper" level="WARN" additivity="false"/>
    <logger name="com.aiops.module.llm.mapper" level="WARN" additivity="false"/>
    <logger name="com.aiops.module.system.mapper" level="WARN" additivity="false"/>
    <logger name="com.aiops.module.esa.mapper" level="WARN" additivity="false"/>
    <logger name="com.aiops.module.incident.mapper" level="WARN" additivity="false"/>
    <logger name="com.aiops.module.notify.mapper" level="WARN" additivity="false"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="com.baomidou" level="WARN"/>
</configuration>
